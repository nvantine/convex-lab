# Local settings. Generate your own secret for hosting. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Historical-data integration arrives in milestone 3. No account/execution keys.
ALPACA_ENV_FILE=../portfolio-lab/.env
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional request budgets; restart after changing. Defaults shown.
LAB_MAX_CRITERIA=8
LAB_MAX_FRONTIER_SAMPLES=50
LAB_FRONTIER_SECONDS=20
LAB_SOLVE_SECONDS=2
