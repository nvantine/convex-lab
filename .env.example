# Local settings. Generate your own secret for hosting. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Historical prices only. Reuse a private file, or set both variables here.
ALPACA_ENV_FILE=../portfolio-lab/.env
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional request budgets; restart after changing. Defaults shown.
LAB_MAX_CRITERIA=8
LAB_MAX_FRONTIER_SAMPLES=50
LAB_FRONTIER_SECONDS=20
LAB_SOLVE_SECONDS=2
LAB_MAX_ASSETS=100
LAB_MAX_PRICE_ROWS=5000
LAB_FETCH_SECONDS=60
LAB_CACHE_HOURS=24
LAB_EVALUATION_SECONDS=45
LAB_MAX_REFITS=300
LAB_MAX_PARAMETER_ENTRIES=500000
LAB_MAX_REQUEST_BYTES=12000000

# HTTPS hosting only: see docs/server-demo.md before enabling proxy trust.
DJANGO_TRUST_PROXY=false
DJANGO_CSRF_TRUSTED_ORIGINS=
